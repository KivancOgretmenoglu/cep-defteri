<?xml version="1.0" encoding="utf-8"?>
<!--
    Sahnenin üstündeki metin paneli: yarı saydam kâğıt (açık) / koyu kâğıt (koyu tema).
    Dokununca uygulamayı açar; basınca panel şeklinde yarı saydam dalga (ripple).
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/widget_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_scrim" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</ripple>
