<?xml version="1.0" encoding="utf-8"?>
<!--
    Büyük araç (4×3 ve üstü): maskot kendi sahnesinde (ViewFlipper ile kare kare canlandırma; kapalıysa sabit kare),
    tutar, dönem, bugünkü harcama, durum notu, "Gider" / "Gelir" ve en fazla 3 tek dokunuşla kayıt çipi.
    Kare görselleri: drawable-nodpi/widget_anim_<anahtar>_<n>.png (scripts/gen-android-icons.ts).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="104dp"
            android:layout_height="94dp">

            <ViewFlipper
                android:id="@+id/widget_flipper"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoStart="true"
                android:flipInterval="420">

                <ImageView
                    android:id="@+id/widget_frame_0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/widget_mascot_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_anim_fistik_0" />

                <ImageView
                    android:id="@+id/widget_frame_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/widget_mascot_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_anim_fistik_1" />

                <ImageView
                    android:id="@+id/widget_frame_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/widget_mascot_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_anim_fistik_2" />

                <ImageView
                    android:id="@+id/widget_frame_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/widget_mascot_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_anim_fistik_3" />

                <ImageView
                    android:id="@+id/widget_frame_4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/widget_mascot_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_anim_fistik_4" />

                <ImageView
                    android:id="@+id/widget_frame_5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/widget_mascot_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_anim_fistik_5" />
            </ViewFlipper>

            <ImageView
                android:id="@+id/widget_static"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/widget_mascot_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_anim_fistik_0"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_title"
                android:textColor="@color/widget_ink_2"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="—"
                android:textColor="@color/widget_ink"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_waiting"
                android:textColor="@color/widget_ink_2"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_today"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/widget_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_btn_expense"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/widget_add_bg"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_expense"
            android:textColor="@color/widget_accent_ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_income"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_secondary"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_income"
            android:textColor="@color/widget_ink"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_chip_0"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textColor="@color/widget_ink"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_chip_1"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textColor="@color/widget_ink"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_chip_2"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textColor="@color/widget_ink"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
