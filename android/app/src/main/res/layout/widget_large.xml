<?xml version="1.0" encoding="utf-8"?>
<!--
    Büyük araç (4×3 ve üstü): maskotun sahnesi tüm zemini kaplar; sağda zemin bandında büyük, canlanan maskot
    (ViewFlipper ile saydam kareler; canlandırma kapalıysa ya da poz varken sabit kare), solda yarı saydam panelde tutar,
    dönem, bugünkü harcama ve durum notu; altta maskot renginde "Gider" / "Gelir" ve en fazla 3 tek dokunuşla kayıt çipi.
    Kareler: drawable-nodpi/widget_anim_<anahtar>_<n>.png (scripts/gen-android-icons.ts).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_scene"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_scene_fistik_tall" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_weight="1"
                android:background="@drawable/widget_panel"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_title"
                    android:textColor="@color/widget_ink_2"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/widget_amount"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:autoSizeMaxTextSize="26sp"
                    android:autoSizeMinTextSize="12sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="—"
                    android:textColor="@color/widget_ink"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_waiting"
                    android:textColor="@color/widget_ink_2"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_today"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_note"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_accent"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp">

                <ViewFlipper
                    android:id="@+id/widget_flipper"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="bottom|end"
                    android:autoStart="true"
                    android:flipInterval="420">

                    <ImageView
                        android:id="@+id/widget_frame_0"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/widget_mascot_desc"
                        android:maxWidth="160dp"
                        android:scaleType="fitEnd"
                        android:src="@drawable/widget_anim_fistik_0" />

                    <ImageView
                        android:id="@+id/widget_frame_1"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/widget_mascot_desc"
                        android:maxWidth="160dp"
                        android:scaleType="fitEnd"
                        android:src="@drawable/widget_anim_fistik_1" />

                    <ImageView
                        android:id="@+id/widget_frame_2"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/widget_mascot_desc"
                        android:maxWidth="160dp"
                        android:scaleType="fitEnd"
                        android:src="@drawable/widget_anim_fistik_2" />

                    <ImageView
                        android:id="@+id/widget_frame_3"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/widget_mascot_desc"
                        android:maxWidth="160dp"
                        android:scaleType="fitEnd"
                        android:src="@drawable/widget_anim_fistik_3" />

                    <ImageView
                        android:id="@+id/widget_frame_4"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/widget_mascot_desc"
                        android:maxWidth="160dp"
                        android:scaleType="fitEnd"
                        android:src="@drawable/widget_anim_fistik_4" />

                    <ImageView
                        android:id="@+id/widget_frame_5"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/widget_mascot_desc"
                        android:maxWidth="160dp"
                        android:scaleType="fitEnd"
                        android:src="@drawable/widget_anim_fistik_5" />
                </ViewFlipper>

                <ImageView
                    android:id="@+id/widget_static"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="bottom|end"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/widget_mascot_desc"
                    android:maxWidth="160dp"
                    android:scaleType="fitEnd"
                    android:src="@drawable/widget_anim_fistik_0"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_btn_expense"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/widget_btn_fistik"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/widget_expense"
                    android:textColor="@color/widget_btn_ink_fistik"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_btn_income"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_btn_soft_fistik"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/widget_income"
                    android:textColor="@color/widget_ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/widget_chips"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_chip_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_chip_fistik"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="@color/widget_ink"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_chip_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/widget_chip_fistik"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="@color/widget_ink"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_chip_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/widget_chip_fistik"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="@color/widget_ink"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
