<?xml version="1.0" encoding="utf-8"?>
<!-- Orta araç (3×2, 4×2): maskot, tutar, dönem, durum notu + "Gider" / "Gelir" düğmeleri. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_mascot"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/widget_mascot_desc"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_mascot_fistik" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_title"
                android:textColor="@color/widget_ink_2"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="—"
                android:textColor="@color/widget_ink"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_waiting"
                android:textColor="@color/widget_ink_2"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/widget_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_btn_expense"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/widget_add_bg"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_expense"
            android:textColor="@color/widget_accent_ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_income"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_secondary"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_income"
            android:textColor="@color/widget_ink"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
