<?xml version="1.0" encoding="utf-8"?>
<!--
    Orta araç (4×2, 5×2 ≈ 1.4:1 ve daha yatay, en az ≈ 260 dp): geniş sahne, solda zemin bandında büyük maskot,
    sağ üstte panelde tutar + dönem + durum notu, altta maskot renginde "Gider" (dolu) / "Gelir" (saydam ton).
    3×2 gibi dar/kareye yakın boyutlar widget_square'e düşer (maskot ile panel çakışmasın).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_frame_fistik"
    android:clipToOutline="true"
    android:foreground="@drawable/widget_ripple_root">

    <!-- Çerçeve: kök zemini maskot renginde (widget_frame_<anahtar>), içerik widget_frame (2 dp) içeride. -->
    <FrameLayout
        android:id="@+id/widget_inner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/widget_frame"
        android:background="@drawable/widget_bg"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/widget_scene"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_scene_fistik_wide" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="8dp">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="44">

                <ImageView
                    android:id="@+id/widget_mascot"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginTop="4dp"
                    android:scaleType="fitEnd"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/widget_mascot_desc"
                    android:src="@drawable/widget_anim_fistik_0" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="56"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/widget_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/widget_panel"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_title"
                        android:textColor="@color/widget_ink_2"
                        android:textSize="11sp" />

                    <!-- Tutar önceliklidir: kesilmez, sığmazsa küçülür (autoSize; Android 8+). -->
                    <TextView
                        android:id="@+id/widget_amount"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:autoSizeMaxTextSize="28sp"
                        android:autoSizeMinTextSize="10sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="—"
                        android:textColor="@color/widget_ink"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_waiting"
                        android:textColor="@color/widget_ink_2"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/widget_note"
                        android:ellipsize="end"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/widget_accent"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_btn_expense"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/widget_btn_fistik"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/widget_expense"
                        android:textColor="@color/widget_btn_ink_fistik"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_btn_income"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/widget_btn_soft_fistik"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/widget_income"
                        android:textColor="@color/widget_ink"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
