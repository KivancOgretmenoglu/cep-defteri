<?xml version="1.0" encoding="utf-8"?>
<!--
    Geniş araç (3×1, 4×1, 5×1 ≈ 3:1–5:1): şerit sahne, solda maskot (genişliği aracın ≈ %30'uyla sınırlanır),
    ortada panelde büyük tutar (önce o; dönem dar araçta kısalır ya da gizlenir), sağda maskot renginde yuvarlak "+".
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_frame_fistik"
    android:clipToOutline="true"
    android:foreground="@drawable/widget_ripple_root">

    <!-- Çerçeve: kök zemini maskot renginde (widget_frame_<anahtar>), içerik widget_frame (2 dp) içeride. -->
    <FrameLayout
        android:id="@+id/widget_inner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/widget_frame"
        android:background="@drawable/widget_bg"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/widget_scene"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_scene_fistik_strip" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/widget_mascot"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="2dp"
                android:maxWidth="100dp"
                android:scaleType="fitEnd"
                android:adjustViewBounds="true"
                android:contentDescription="@string/widget_mascot_desc"
                android:src="@drawable/widget_anim_fistik_0" />

            <LinearLayout
                android:id="@+id/widget_body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:background="@drawable/widget_panel"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_title"
                    android:textColor="@color/widget_ink_2"
                    android:textSize="10sp" />

                <!-- Tutar önceliklidir: kesilmez, sığmazsa küçülür (autoSize; Android 8+). -->
                <TextView
                    android:id="@+id/widget_amount"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:autoSizeMaxTextSize="30sp"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="—"
                    android:textColor="@color/widget_ink"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_waiting"
                    android:textColor="@color/widget_ink_2"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_note"
                    android:ellipsize="end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_accent"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_add"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_fab_fistik"
                android:contentDescription="@string/widget_add_desc"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="+"
                android:textColor="@color/widget_btn_ink_fistik"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
