<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <!-- Başlatıcı girişi aşağıdaki activity-alias'larda (seçilen maskota göre simge). -->

            <!-- Derin bağlantı: io.github.kivancogretmenoglu.cepdefteri://add[?type=expense|income] → ekleme sayfası (araç düğmeleri, hızlı ayarlar kutucuğu). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/custom_url_scheme" />
            </intent-filter>

        </activity>

        <!--
            Uygulama simgesi = seçilen maskot (AppIconPlugin.java). Her maskot için bir takma ad; aynı anda yalnız biri
            etkindir. Varsayılan: Fıstık. Adlar AppIconPlugin.KEYS ile aynı olmalı (".Icon_<anahtar>").
        -->
        <activity-alias
            android:name=".Icon_fistik"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_fistik"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_fistik_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Icon_bilge"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_bilge"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_bilge_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Icon_ceviz"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ceviz"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_ceviz_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Icon_diken"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_diken"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_diken_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Icon_karamel"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_karamel"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_karamel_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Icon_pamuk"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_pamuk"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_pamuk_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Ana ekran aracı: kullanılabilir para, boyuta göre düzen; çiplerden gelen yayınlar (WIDGET_QUICK/WIDGET_REFRESH) açık niyetle gelir. -->
        <receiver
            android:name=".CepWidgetProvider"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cep_widget_info" />
        </receiver>

        <!-- Hızlı ayarlar kutucuğu: "Cep Defteri: + Kayıt" → yeni kayıt sayfası (AddTileService.java). -->
        <service
            android:name=".AddTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_add"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Bildirimler (Android 13+ çalışma anında izin sorulur) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Otomatik yedeği Belgeler klasörüne yazmak için yalnız eski Android sürümlerinde gerekir -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
</manifest>
