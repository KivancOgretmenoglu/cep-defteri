[[0.07, 1.46, "Kafedeki orta boy kahve,", 1300, [0.1, 0.68, 0.97, 1.12]], [1.47, 3.06, "satılmak için orada değil.", 1300, [1.5, 1.93, 2.22, 2.66]], [3.07, 5.11, "Sen olsan hangisini alırdın?", 1300, [3.1, 3.26, 3.58, 4.23]], [6.32, 7.91, "Çoğumuz büyüğü seçeriz.", 1300, [6.35, 6.85, 7.35]], [7.92, 9.26, "Sadece beş lira fark!", 1300, [7.95, 8.45, 8.62, 8.95]], [9.27, 11.02, "Ama orta boy olmasaydı,", 1300, [9.3, 9.67, 10.03, 10.22]], [11.03, 12.31, "büyük bu kadar cazip", 1300, [11.06, 11.43, 11.61, 11.98]], [12.32, 13.26, "görünmezdi.", 1300, [12.35]], [13.27, 14.98, "Buna tuzak seçenek denir.", 1300, [13.3, 13.66, 14.02, 14.55]], [14.99, 15.62, "Orta boy,", 1300, [15.02, 15.38]], [15.63, 17.41, "büyüğü ucuz göstermek için", 1300, [15.66, 16.2, 16.56, 17.09]], [17.42, 18.36, "orada.", 1300, [17.45]], [18.37, 20.35, "İki seçenek arasında kalınca", 1300, [18.4, 18.73, 19.23, 19.89]], [20.36, 20.62, "sor:", 1300, [20.39]], [20.63, 22.88, "ortadaki olmasa ne alırdım?", 1300, [20.66, 21.32, 21.82, 21.98]]]