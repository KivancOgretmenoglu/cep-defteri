[[0.07, 0.93, "Bilete üç yüz", 1232, [0.1, 0.62, 0.79]], [0.94, 1.72, "lira verdin.", 1232, [0.97, 1.31]], [1.73, 2.35, "Film berbat.", 1232, [1.76, 1.94]], [2.36, 3.36, "Kalır mısın?", 1232, [2.39, 2.73]], [3.37, 4.24, "Diken kalıyor.", 1232, [3.4, 3.72]], [4.25, 5.46, "Paraya yazık!", 1232, [4.28, 4.75]], [6.92, 7.79, "Kalsa da çıksa", 1232, [6.95, 7.3, 7.48]], [7.8, 8.07, "da,", 1232, [7.83]], [8.08, 8.6, "o üç yüz", 1232, [8.11, 8.29, 8.46]], [8.61, 9.36, "lira gitti.", 1232, [8.64, 8.99]], [9.37, 10.1, "Kalmanın tek", 1232, [9.4, 9.95]], [10.11, 10.76, "bedeli:", 1232, [10.14]], [10.77, 11.61, "iki saat.", 1232, [10.8, 11.17]], [11.62, 12.57, "Geri gelmeyen bu", 1232, [11.65, 11.97, 12.45]], [12.58, 13.14, "paraya,", 1232, [12.61]], [13.15, 13.94, "batık maliyet", 1232, [13.18, 13.5]], [13.95, 14.26, "denir.", 1232, [13.98]], [14.27, 15.09, "Kendine sor:", 1232, [14.3, 14.84]], [15.1, 15.99, "bundan sonrası", 1232, [15.13, 15.49]], [16.0, 17.0, "buna değer mi?", 1232, [16.03, 16.39, 16.76]]]