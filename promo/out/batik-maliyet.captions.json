[[0.07, 0.91, "Bilete üç yüz", 1052, [0.1, 0.61, 0.78]], [0.92, 1.7, "lira verdin.", 1052, [0.95, 1.29]], [1.71, 2.31, "Film berbat.", 1052, [1.74, 1.91]], [2.32, 3.43, "Kalır mısın?", 1052, [2.35, 2.69]], [6.52, 7.22, "Kalsa da çıksa", 1052, [6.55, 6.83, 6.97]], [7.23, 7.44, "da,", 1052, [7.26]], [7.45, 8.01, "üç yüz lira", 1052, [7.48, 7.62, 7.77]], [8.02, 8.41, "gitti!", 1052, [8.05]], [8.42, 9.02, "Kalırsan,", 1052, [8.45]], [9.03, 10.05, "iki saatin de", 1052, [9.06, 9.41, 9.92]], [10.06, 10.51, "gider.", 1052, [10.09]], [10.52, 11.17, "Geri gelmeyen", 1052, [10.55, 10.81]], [11.18, 11.64, "paraya,", 1052, [11.21]], [11.65, 12.3, "batık maliyet", 1052, [11.68, 11.95]], [12.31, 12.76, "denir!", 1052, [12.34]], [12.77, 13.45, "Kendine sor:", 1052, [12.8, 13.25]], [13.46, 14.2, "Bundan sonrası", 1052, [13.49, 13.79]], [14.21, 15.15, "buna değer mi?", 1052, [14.24, 14.54, 14.84]]]