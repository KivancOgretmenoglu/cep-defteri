[[0.07, 1.42, "Yüzde elli indirimde bin", 1255, [0.1, 0.4, 0.7, 1.31]], [1.43, 2.26, "lira harcadın.", 1255, [1.46, 1.76]], [2.27, 3.61, "Beş yüz lira kazanmadın.", 1255, [2.3, 2.46, 2.61, 2.91]], [3.62, 4.01, "Pamuk,", 1255, [3.65]], [4.02, 5.09, "iki binlik montu bin", 1255, [4.05, 4.36, 4.67, 4.98]], [5.1, 5.95, "liraya aldı.", 1255, [5.13, 5.59]], [5.96, 7.81, "Bin lira kazandığını sanıyor.", 1255, [5.99, 6.15, 6.45, 7.23]], [7.82, 8.44, "Tahmin et:", 1255, [7.85, 8.2]], [8.45, 10.79, "Pamuk'un cüzdanında ne değişti?", 1255, [8.48, 9.0, 9.69, 9.87]], [12.02, 13.31, "Eksi bin lira.", 1255, [12.05, 12.48, 12.69]], [13.32, 14.28, "Çünkü tasarruf,", 1255, [13.35, 13.7]], [14.29, 15.96, "harcamadığın paradır.", 1255, [14.32, 15.18]], [15.97, 17.56, "İndirimde kendine sor:", 1255, [16.0, 16.75, 17.3]], [17.57, 19.24, "indirim olmasa da alır", 1255, [17.6, 18.16, 18.72, 18.91]], [19.25, 19.72, "mıydım?", 1255, [19.28]], [19.73, 20.77, "Cevap hayırsa,", 1255, [19.76, 20.14]], [20.78, 21.62, "kazanmadın.", 1255, [20.81]], [21.63, 22.63, "Harcadın.", 1255, [21.66]]]