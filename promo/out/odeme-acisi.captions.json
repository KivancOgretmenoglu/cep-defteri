[[0.07, 0.64, "Aynı dört yüz", 1062, [0.1, 0.39, 0.54]], [0.65, 1.31, "elli lira.", 1062, [0.68, 0.97]], [1.32, 2.18, "Hangisi daha çok", 1062, [1.35, 1.78, 2.07]], [2.19, 3.04, "acıtır?", 1062, [2.22]], [3.67, 4.48, "Nakitte her", 1062, [3.7, 4.31]], [4.49, 5.62, "banknot acıtır.", 1062, [4.52, 4.93]], [5.63, 6.65, "Kartta sadece", 1062, [5.66, 6.07]], [6.66, 7.01, "bip!", 1062, [6.69]], [7.02, 7.89, "Acı yoksa fren", 1062, [7.05, 7.4, 7.75]], [7.9, 8.35, "de yok:", 1062, [7.93, 8.11]], [8.36, 9.21, "sepet büyür!", 1062, [8.39, 8.74]], [9.22, 9.91, "Ay sonu:", 1062, [9.25, 9.44]], [9.92, 10.69, "ekstre dört bin", 1062, [9.95, 10.34, 10.53]], [10.7, 11.66, "üç yüz lira?!", 1062, [10.73, 10.92, 11.12]], [11.67, 12.7, "Buna ödeme acısı", 1062, [11.7, 11.96, 12.35]], [12.71, 13.06, "denir.", 1062, [12.74]], [13.07, 14.04, "Kartla ödediysen", 1062, [13.1, 13.43]], [14.05, 14.64, "hemen yaz.", 1062, [14.08, 14.41]], [14.65, 15.23, "Yazınca,", 1062, [14.68]], [15.24, 16.35, "acı geri gelir.", 1062, [15.27, 15.59, 15.92]]]