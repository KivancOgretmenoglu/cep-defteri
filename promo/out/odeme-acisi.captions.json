[[0.07, 0.61, "Aynı dört yüz", 1062, [0.1, 0.38, 0.51]], [0.62, 1.25, "elli lira.", 1062, [0.65, 0.93]], [1.26, 2.5, "Hangisi acıtır?", 1062, [1.29, 1.7]], [3.13, 3.94, "Nakitte her", 1062, [3.16, 3.77]], [3.95, 5.08, "banknot acıtır.", 1062, [3.98, 4.39]], [5.09, 6.11, "Kartta sadece", 1062, [5.12, 5.53]], [6.12, 6.47, "bip!", 1062, [6.15]], [6.48, 7.35, "Acı yoksa fren", 1062, [6.51, 6.86, 7.21]], [7.36, 7.81, "de yok:", 1062, [7.39, 7.57]], [7.82, 8.67, "sepet büyür!", 1062, [7.85, 8.2]], [8.68, 9.37, "Ay sonu:", 1062, [8.71, 8.9]], [9.38, 10.15, "ekstre dört bin", 1062, [9.41, 9.8, 9.99]], [10.16, 11.12, "üç yüz lira?!", 1062, [10.19, 10.38, 10.58]], [11.13, 12.37, "Buna ödeme acısı", 1062, [11.16, 11.47, 11.94]], [12.38, 12.78, "denir.", 1062, [12.41]], [12.79, 13.41, "Kart acıyı", 1062, [12.82, 12.98]], [13.42, 13.81, "silmez,", 1062, [13.45]], [13.82, 14.41, "erteler!", 1062, [13.85]], [14.42, 15.39, "Kartla ödediysen", 1062, [14.45, 14.78]], [15.4, 15.99, "hemen yaz.", 1062, [15.43, 15.76]], [16.0, 16.58, "Yazınca,", 1062, [16.03]], [16.59, 17.7, "acı geri gelir.", 1062, [16.62, 16.94, 17.27]]]