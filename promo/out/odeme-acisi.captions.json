[[0.07, 0.64, "Aynı dört yüz", 1062, [0.1, 0.39, 0.54]], [0.65, 1.31, "elli lira.", 1062, [0.68, 0.97]], [1.32, 2.18, "Hangisi daha çok", 1062, [1.35, 1.78, 2.07]], [2.19, 3.04, "acıtır?", 1062, [2.22]], [3.07, 3.88, "Nakitte her", 1062, [3.1, 3.71]], [3.89, 5.02, "banknot acıtır.", 1062, [3.92, 4.33]], [5.03, 6.05, "Kartta sadece", 1062, [5.06, 5.47]], [6.06, 6.41, "bip!", 1062, [6.09]], [6.42, 7.29, "Acı yoksa fren", 1062, [6.45, 6.8, 7.15]], [7.3, 7.75, "de yok:", 1062, [7.33, 7.51]], [7.76, 8.61, "sepet büyür!", 1062, [7.79, 8.14]], [8.62, 9.31, "Ay sonu:", 1062, [8.65, 8.84]], [9.32, 10.09, "ekstre dört bin", 1062, [9.35, 9.74, 9.93]], [10.1, 11.06, "üç yüz lira?!", 1062, [10.13, 10.32, 10.52]], [11.07, 12.1, "Buna ödeme acısı", 1062, [11.1, 11.36, 11.75]], [12.11, 12.46, "denir.", 1062, [12.14]], [12.47, 13.44, "Kartla ödediysen", 1062, [12.5, 12.83]], [13.45, 14.04, "hemen yaz.", 1062, [13.48, 13.81]], [14.05, 14.63, "Yazınca,", 1062, [14.08]], [14.64, 15.75, "acı geri gelir.", 1062, [14.67, 14.99, 15.32]]]