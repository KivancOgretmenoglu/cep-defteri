[[0.07, 0.75, "Masada 1.000", 740, [0.1, 0.62]], [0.76, 1.38, "lira var.", 740, [0.79, 1.14]], [1.39, 2.51, "Ama bir şartla.", 740, [1.42, 1.77, 1.94]], [2.52, 3.3, "Ceviz böler.", 740, [2.55, 2.89]], [3.31, 4.44, "Diken reddederse,", 740, [3.34, 3.69]], [4.45, 5.71, "ikisi de sıfır!", 740, [4.48, 5.0, 5.17]], [5.72, 7.09, "Ceviz'in teklifi:", 740, [5.75, 6.38]], [7.1, 8.26, "900 bana,", 740, [7.13, 7.75]], [8.27, 9.16, "100 sana.", 740, [8.3, 8.5]], [9.17, 10.19, "Sen Diken olsan?", 740, [9.2, 9.38, 9.75]], [10.2, 10.85, "Kabul mü,", 740, [10.23, 10.6]], [10.86, 11.67, "ret mi?", 740, [10.89, 11.07]], [12.92, 14.09, "Diken reddetti.", 740, [12.95, 13.37]], [14.1, 15.61, "İkisi de sıfır!", 740, [14.13, 14.76, 14.97]], [15.62, 16.14, "Saçma mı?", 740, [15.65, 15.94]], [16.15, 16.72, "Deneylerde", 740, [16.18]], [16.73, 17.75, "insanların yarısı", 740, [16.76, 17.35]], [17.76, 19.01, "aynısını yapıyor.", 740, [17.79, 18.37]], [19.02, 20.0, "Buna ültimatom", 740, [19.05, 19.38]], [20.01, 20.92, "oyunu denir.", 740, [20.04, 20.53]], [20.93, 21.74, "Adil böl; yoksa", 740, [20.96, 21.29, 21.45]], [21.75, 22.4, "iki taraf", 740, [21.78, 22.11]], [22.41, 23.1, "da sıfır.", 740, [22.44, 22.6]]]