[[0.07, 0.75, "Masada 1.000", 740, [0.1, 0.62]], [0.76, 1.38, "lira var.", 740, [0.79, 1.14]], [1.39, 2.51, "Ama bir şartla.", 740, [1.42, 1.77, 1.94]], [2.52, 3.3, "Ceviz böler.", 740, [2.55, 2.89]], [3.31, 4.44, "Diken reddederse,", 740, [3.34, 3.69]], [4.45, 5.71, "ikisi de sıfır!", 740, [4.48, 5.0, 5.17]], [5.72, 7.09, "Ceviz'in teklifi:", 740, [5.75, 6.38]], [7.1, 8.26, "900 bana,", 740, [7.13, 7.75]], [8.27, 9.16, "100 sana.", 740, [8.3, 8.5]], [9.17, 10.19, "Sen Diken olsan?", 740, [9.2, 9.38, 9.75]], [10.2, 10.85, "Kabul mü,", 740, [10.23, 10.6]], [10.86, 11.67, "ret mi?", 740, [10.89, 11.07]], [14.54, 15.71, "Diken reddetti.", 740, [14.57, 14.99]], [15.72, 17.23, "İkisi de sıfır!", 740, [15.75, 16.38, 16.59]], [17.24, 17.76, "Saçma mı?", 740, [17.27, 17.56]], [17.77, 18.34, "Deneylerde", 740, [17.8]], [18.35, 19.37, "insanların yarısı", 740, [18.38, 18.97]], [19.38, 20.61, "aynısını yapıyor.", 740, [19.41, 19.99]], [20.62, 21.57, "Bu oyunun adı", 740, [20.65, 20.81, 21.29]], [21.58, 22.31, "ültimatom.", 740, [21.61]], [22.32, 23.12, "Adil böl; yoksa", 740, [22.35, 22.68, 22.84]], [23.13, 24.08, "ikisi de sıfır", 740, [23.16, 23.64, 23.8]], [24.09, 25.0, "kalabilir.", 740, [24.12]]]